<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="480dp"
    android:background="@drawable/bg_panel"
    android:elevation="12dp"
    android:orientation="vertical">

    <!-- Top Bar / Drag Handle -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/padding_large">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ NEBULA"
            android:textColor="@color/accent_purple"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/btnMinimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:text="@string/minimize"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:text="@string/close"
            android:textColor="@color/error_red"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/divider" />

    <!-- Tab Bar -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/padding_medium"
        android:paddingVertical="@dimen/padding_small"
        android:background="@color/surface_dark">

        <TextView
            android:id="@+id/tabEditor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:text="@string/tab_editor"
            android:textColor="@color/text_white"
            android:textSize="@dimen/text_size_small"
            android:selected="true" />

        <TextView
            android:id="@+id/tabScripts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:text="@string/tab_scripts"
            android:textColor="@color/text_white"
            android:textSize="@dimen/text_size_small" />

        <TextView
            android:id="@+id/tabConsole"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:text="@string/tab_console"
            android:textColor="@color/text_white"
            android:textSize="@dimen/text_size_small" />

        <TextView
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:text="@string/tab_settings"
            android:textColor="@color/text_white"
            android:textSize="@dimen/text_size_small" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/divider" />

    <!-- Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Editor Panel -->
        <LinearLayout
            android:id="@+id/editorPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <EditText
                android:id="@+id/etScript"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_editor"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="@string/editor_hint"
                android:textColorHint="@color/hint_gray"
                android:inputType="textMultiLine|textNoSuggestions"
                android:padding="@dimen/padding_large"
                android:scrollbars="vertical"
                android:textColor="@color/console_green"
                android:textSize="@dimen/editor_text_size"
                android:overScrollMode="always" />

            <!-- Action Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/action_button_height"
                android:layout_marginTop="@dimen/padding_medium"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnExecute"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center"
                    android:text="▶ Execute"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_button_secondary"
                    android:gravity="center"
                    android:text="@string/clear"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/btnCopy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_button_secondary"
                    android:gravity="center"
                    android:text="@string/copy"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/btnPaste"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_button_secondary"
                    android:gravity="center"
                    android:text="@string/paste"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_size_small" />
            </LinearLayout>
        </LinearLayout>

        <!-- Scripts Panel -->
        <LinearLayout
            android:id="@+id/scriptsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Script Library"
                android:textColor="@color/secondary_purple"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                android:paddingBottom="@dimen/padding_medium" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvScripts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- Console Panel -->
        <LinearLayout
            android:id="@+id/consolePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/consoleScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_console"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tvConsole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="@dimen/padding_large"
                    android:text="@string/console_welcome"
                    android:textColor="@color/console_green"
                    android:textSize="@dimen/text_size_small" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/action_button_height"
                android:layout_marginTop="@dimen/padding_medium"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnClearConsole"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:gravity="center"
                    android:text="Clear Console"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_size_small" />
            </LinearLayout>
        </LinearLayout>

        <!-- Settings Panel -->
        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/padding_xlarge"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@color/secondary_purple"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                android:paddingBottom="@dimen/padding_large" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/padding_medium">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_auto_execute"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_size_medium" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAutoExec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/padding_medium">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_timestamps"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_size_medium" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTimestamps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/padding_medium">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_auto_inject"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_size_medium" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAutoInject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/padding_medium">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_topmost"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_size_medium" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTopmost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/padding_medium">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_font_size"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_size_medium" />
                <TextView
                    android:id="@+id/tvFontSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="13"
                    android:textColor="@color/accent_purple"
                    android:textSize="@dimen/text_size_medium"
                    android:paddingHorizontal="@dimen/padding_medium" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
